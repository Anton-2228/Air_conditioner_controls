# Токен бота от @BotFather
API_TOKEN=

# Кому разрешено управлять кондиционером. chat_id через запятую.
# Свой id можно узнать у @userinfobot. Пустое значение = бот не запустится.
ALLOWED_CHAT_IDS=

# Брокер MQTT. Внутри docker compose хост — имя сервиса mosquitto,
# оно проставляется в compose.yml и здесь не нужно.
MQTT_HOST=mosquitto
MQTT_PORT=1883

# Порт брокера СНАРУЖИ — на него стучится плата (MqttPort в Tasmota).
# Бот его не использует: он ходит к брокеру внутри compose на 1883.
# За NAT хостера ставьте порт из выданного диапазона, например 41141.
MQTT_PUBLIC_PORT=1883
MQTT_USER=bot
MQTT_PASSWORD=

# ClientId бота. ОБЯЗАН отличаться от ClientId платы (tasmota_A3CA74),
# иначе брокер будет по очереди выкидывать обоих.
MQTT_CLIENT_ID=ac_bot

# Базовый топик устройства, задан в Tasmota командой Topic
TASMOTA_TOPIC=tasmota_A3CA74

# --- Протокол кондиционера ---
# Определяется пультом, а не маркой на корпусе. Подобрать можно
# скриптом scripts/probe_vendor.sh, он перебирает кандидатов.
# Имя — ровно как в списке Tasmota: GREE, ELECTRA_AC, HAIER_AC, COOLIX...
# «Electra» вместо «ELECTRA_AC» плата отвергнет. Полный список она выдаёт
# сама в ответ на неверное имя.
AC_VENDOR=GREE
# Вариант модели внутри вендора. Пусто — не отправлять ключ Model вообще.
AC_MODEL=YAW1F
# Диапазон температур этого кондиционера
AC_MIN_TEMP=17
AC_MAX_TEMP=30
# Подсветку дисплея понимают не все протоколы. 0 — не отправлять ключ Light.
AC_SEND_LIGHT=1

# Сколько ждать ответа в stat/<топик>/RESULT, секунды
MQTT_ACK_TIMEOUT=5.0
# Пауза перед переподключением к брокеру, секунды
MQTT_RECONNECT_DELAY=5.0

# Файл состояния кондиционера. В docker лежит на томе.
STATE_FILE_PATH=/data/state.json

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Прокси для запросов к Telegram, если сервер до api.telegram.org не достаёт.
# socks5://хост:порт или http://хост:порт. Пусто — ходить напрямую.
# MTProto-прокси не подойдёт: он для клиентов Telegram, а не для Bot API.
TELEGRAM_PROXY=
